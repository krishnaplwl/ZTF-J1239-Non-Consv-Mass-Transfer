&star_job

   create_pre_main_sequence_model = .true.
   pre_ms_relax_to_start_radiative_core = .false.   ! BDs are fully convective

   ! create at 0.03 Msun, then relax mass down at age 0
   relax_mass_scale = .true.
   dlgm_per_step = 1d-3
   new_mass = 1.90918000d-02   ! 20 MJup
   change_mass_years_for_dt = 1

   save_model_when_terminate = .true.
   save_model_filename = '../../models/M20_1Gyr.mod'
   history_columns_file = 'history_columns.list'
   profile_columns_file = 'profile_columns.list'
   pgstar_flag = .false.

/ ! end of star_job namelist

&eos
/ ! end of eos namelist

&kap
   use_Type2_opacities = .true.
   Zbase = 0.02
/ ! end of kap namelist

&controls

   initial_mass = 3.00000000d-02   ! 20 MJup  (raised to MESA minimum; relaxed below)
   initial_z = 0.02
   atm_option = 'table'
   atm_table = 'tau_100'

   energy_eqn_option = 'dedt'
   use_gold_tolerances = .true.
   varcontrol_target = 1d-4
   mesh_delta_coeff = 1.0

   max_age = 1.00000000d+09
   max_years_for_timestep = 1.00000000d+07

   history_interval = 10
   write_profiles_flag = .false.
   photo_interval = 500
   terminal_interval = 200
   max_model_number = 400000
   log_directory = 'LOGS'
   photo_directory = 'photos'

/ ! end of controls namelist

&pgstar
/ ! end of pgstar namelist
